PORT=8788
NODE_ENV=production
SCOPEZERO_STORE=postgres
DATABASE_URL=postgres://scopezero:replace-me@scopezero-postgres.example.com:5432/scopezero?sslmode=require
SCOPEZERO_REQUIRE_AUTH=true
SCOPEZERO_ALLOW_DEV_TOKEN=false
SCOPEZERO_CORS_ORIGIN=https://scopezero.example.com
# Ed25519 private key (PEM) that signs mission capsules + agent certs. REQUIRED in
# production — the gateway refuses to boot without it (it will not derive the key
# from the shared secret in prod). Distribute only the public key to verifiers.
# Generate: node tools/gen-keys.js   (or: openssl genpkey -algorithm ed25519)
SCOPEZERO_SIGNING_PRIVATE_KEY=
# Retired/rotated PUBLIC keys (PEM, comma- or blank-line-separated) still allowed
# to verify. Add the previous public key here during a rotation so live capsules/
# certs signed under it keep verifying until they expire.
SCOPEZERO_SIGNING_PUBLIC_KEYS=
# Keys the ledger HMAC chain. Must be a non-default value in production. In dev
# (only) it also derives the Ed25519 keypair when no private key is set.
SCOPEZERO_SIGNING_SECRET=replace-with-strong-mission-capsule-secret
# Egress containment posture — REQUIRED in production (k8s|docker). The gateway
# refuses to boot without it. Verify the kernel block with: node tools/lockdown-selftest.js
SCOPEZERO_EGRESS_LOCKDOWN=k8s
# Optional: reject tool calls that didn't traverse the enforced ingress (SDK/proxy
# stamps X-ScopeZero-Proxy-Path: <marker>). Does not replace the kernel lockdown.
SCOPEZERO_REQUIRE_PROXY_PATH=false
SCOPEZERO_PROXY_PATH_MARKER=
SCOPEZERO_AUTH_SECRET=replace-with-strong-token-secret
SCOPEZERO_API_KEY=replace-with-service-api-key
SCOPEZERO_SECRETS_PROVIDER=local
SCOPEZERO_LEDGER_ANCHOR_FILE=
SCOPEZERO_LEDGER_ANCHOR_URL=
SCOPEZERO_LEDGER_ANCHOR_SECRET=
SCOPEZERO_LEDGER_ANCHOR_EVERY=1
SCOPEZERO_LEDGER_ANCHOR_REQUIRED=false
SCOPEZERO_SECRETS_MASTER_KEY=replace-with-32-byte-or-longer-secrets-master-key
SCOPEZERO_RATE_LIMIT_PER_MINUTE=600
SCOPEZERO_PUBLIC_BASE_URL=https://scopezero.example.com
SCOPEZERO_OIDC_ISSUER=https://login.example.com/
SCOPEZERO_OIDC_AUDIENCE=api://scopezero
SCOPEZERO_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
OTEL_SERVICE_NAME=scopezero-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer replace-with-otel-token
SCOPEZERO_SLACK_CLIENT_ID=
SCOPEZERO_GITHUB_CLIENT_ID=
SCOPEZERO_GOOGLE_CLIENT_ID=
SCOPEZERO_MICROSOFT_CLIENT_ID=
