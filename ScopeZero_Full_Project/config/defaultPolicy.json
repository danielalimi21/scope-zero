{
  "policy_id": "scopezero.enterprise.default",
  "version": "0.1.0",
  "mode": "enforce",
  "category": "vendor_neutral_agent_action_authorization",
  "action_contracts_required": true,
  "strict_data_class_enforcement": true,
  "strict_destination_enforcement": true,
  "mission_lock": true,
  "prompt_injection_shield": true,
  "prompt_influence_threshold": 40,
  "sensitive_egress_guard": true,
  "approval_gates": true,
  "redact_sensitive_outputs": true,
  "max_delegation_depth": 1,
  "runtime_risk_budget": 68,
  "financial_approval_threshold": 50000,
  "admin_privilege_requires_approval": true,
  "require_manifest_for_high_impact": true,
  "require_manifest_for_mutating": true,
  "mutating_operations": ["write", "export", "payment", "privilege_change", "delegate", "external_send"],
  "unknown_egress_requires_approval": true,
  "sensitive_ingest_egress_guard": true,
  "seal_sensitive_mission_egress": false,
  "ingest_taint_block_level": 4,
  "sensitive_data_block_level": 4,
  "behavior_daily_volume_cap": 500,
  "behavior_daily_volume_cap_high_risk": 50,
  "decision_cache_enabled": true,
  "decision_cache_ttl_ms": 5000,
  "high_impact_action_types": [
    "external_send",
    "export",
    "privilege_change",
    "payment",
    "delegate"
  ],
  "blocked_action_types": [
    "credential_exfiltration",
    "policy_bypass"
  ],
  "evidence_schema": "scopezero.action_authorization.v1",
  "trusted_destinations": [
    "contoso.example",
    "diligence-room.contoso.example"
  ],
  "blocked_prompt_patterns": [
    "ignore previous",
    "ignore all previous",
    "bypass policy",
    "send to external",
    "exfiltrate",
    "disable guardrails",
    "reveal system prompt"
  ]
}
